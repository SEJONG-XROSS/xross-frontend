# pnpm + React Native / Expo 호환성 설정
# Metro bundler가 필요로 하는 패키지들을 루트 node_modules에 호이스팅

# Babel 런타임 — Metro가 직접 resolve해야 하는 helpers
public-hoist-pattern[]=@babel/runtime
public-hoist-pattern[]=@babel/runtime/*

# React 싱글톤 보장
public-hoist-pattern[]=react
public-hoist-pattern[]=react-dom

# React Native 코어 패키지
public-hoist-pattern[]=react-native
public-hoist-pattern[]=react-native/*
