{
  "name": "xross",
  "private": true,
  "scripts": {
    "dev:web": "turbo dev --filter=@xross/web",
    "build": "turbo build",
    "build:web": "turbo build --filter=@xross/web",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.5.4"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "react-native-css-interop": "0.1.22"
    }
  }
}
